{
  "name": "dsh-reference-session-collector",
  "version": "0.2.4",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "tag": "beta",
    "access": "public"
  },
  "description": "DSH Web 插件：会话原文投影同步器（DRS）——只读扫描 ~/.dsh/sessions 会话日志，解码后投影进自有 SQLite（segments/replaces/FTS5），经 /api/dsh-reference-session-collector 提供 surface 标记、召回对账与内容检索面。绝不写会话文件。",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "fts5",
    "projection",
    "search",
    "session",
    "sqlite",
    "tokenizer"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drscrewdriver/dsh-reference-session-collector.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('lib',{recursive:true,force:true})\" && tsdown",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "smoke": "node scripts/smoke-lib.mjs",
    "smoke:real": "node scripts/rebuild-smoke.mjs",
    "test": "vitest run",
    "lint": "eslint src tests eslint.config.js",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build && npm run smoke"
  },
  "files": [
    "README.md",
    "README.en.md",
    "README.ja.md",
    "README.ko.md",
    "README.de.md",
    "README.es.md",
    "README.fr.md",
    "README.ru.md",
    "README.it.md",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "lib",
    "src",
    "assets"
  ],
  "engines": {
    "node": ">=22",
    "dsh": "0.1.0-rc.2 || 0.1.0-rc.3 || 0.1.0-rc.6 || 0.1.0-rc.7 || 0.1.0-rc.8 || 0.1.1-rc.1 || 0.1.1-rc.2 || 0.1.2-rc.1 || 0.1.5-rc.1 || 0.1.5-rc.2 || 0.1.5-rc.3 || 0.1.7-rc.1 || 0.1.7-rc.2 || 0.2.0-rc.1 || 0.2.0-rc.2 || 0.2.1-rc.1 || 0.2.1-rc.2 || 0.2.1-rc.3 || 0.2.1-rc.4 || 0.2.1-rc.5"
  },
  "license": "MIT",
  "dependencies": {
    "@huggingface/tokenizers": "0.1.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "tsdown": "^0.22.2",
    "tsx": "^4.23.12",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.1"
  }
}
